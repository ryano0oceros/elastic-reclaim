graph TB
    subgraph DEV["👤 Developer workstation"]
        CLI["OpenCode CLI<br/><i>terminal</i>"]
        VSC["OpenCode<br/>VS Code extension"]
        CFG["opencode.json + eis-proxy.env<br/><i>generated by dev-setup.sh</i>"]
    end

    subgraph AWS["☁️ AWS — account 083732173806 / us-east-1"]
        ALB["Application Load Balancer<br/><b>stable DNS</b> · HTTP:80"]
        subgraph TASK["ECS Fargate task — FastAPI proxy"]
            AUTH["1 · Bearer auth<br/><i>compare_digest, fail-closed</i>"]
            ROUTE["2 · Model routing<br/><i>alias → inference_id</i>"]
            TRANS["3 · Protocol translation<br/><i>strip cache_control / tool_calls.index</i>"]
            TELE["4 · Usage telemetry<br/><i>fire-and-forget</i>"]
        end
        SM["Secrets Manager<br/>ELASTIC_API_KEY · PROXY_API_KEY"]
        ECR["ECR<br/><i>immutable tags, scan-on-push</i>"]
        CW["CloudWatch Logs<br/><i>shape diagnostics, no prompts</i>"]
    end

    subgraph ES["🔍 Elastic Serverless project"]
        subgraph EIS["EIS inference endpoints — one per alias"]
            M1["claude-opus / claude-sonnet"]
            M2["gemini-pro / gemini-flash"]
            M3["gpt-sol / gpt-terra"]
        end
        USAGE[("eis-proxy-usage<br/><i>metadata only · 180d</i>")]
        CAP[("eis-proxy-captures<br/><i>prompt content · 30d · toggle</i>")]
        KB["Kibana dashboards<br/>Usage · Reliability<br/>Query Analytics · Cost (ECU)"]
    end

    LLM["Claude · Gemini · GPT<br/><i>billed to Elastic commit</i>"]

    CLI --> CFG
    VSC --> CFG
    CFG -->|"OpenAI /v1/chat/completions<br/>Bearer + X-EIS-User"| ALB
    ALB -->|"SG-restricted :8000"| AUTH
    AUTH --> ROUTE --> TRANS
    TRANS -->|"POST /_inference/chat_completion/{id}/_stream<br/>Authorization: ApiKey"| EIS
    EIS --> LLM
    LLM -.->|"SSE stream back"| TRANS
    TRANS -.->|"OpenAI-compatible SSE"| ALB
    TRANS --> TELE
    TELE -->|"per request: user, model,<br/>tokens, latency, ECU cost"| USAGE
    TELE -.->|"only when capture_requests=true"| CAP
    USAGE --> KB
    CAP --> KB
    SM -.->|"injected at task start"| TASK
    ECR -.->|"image pull"| TASK
    TASK -.-> CW

    classDef devBox fill:#1e3a5f,stroke:#4a90d9,color:#e8f0fe
    classDef awsBox fill:#3d2e14,stroke:#ff9900,color:#fff4e6
    classDef esBox fill:#0d3b33,stroke:#00bfb3,color:#e0f7f4
    classDef llmBox fill:#3d1f3d,stroke:#c77dc7,color:#fce8fc
    classDef store fill:#14304a,stroke:#5aa9e6,color:#e8f4fd

    class CLI,VSC,CFG devBox
    class ALB,AUTH,ROUTE,TRANS,TELE,SM,ECR,CW awsBox
    class M1,M2,M3,KB esBox
    class USAGE,CAP store
    class LLM llmBox
