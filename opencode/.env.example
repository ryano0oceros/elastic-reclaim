# Prefer `scripts/dev-setup.sh <username>` - it generates a personalized
# bundle (config + env) from live Terraform outputs. This file documents the
# variables for manual setup.

# Stable ALB URL: terraform -chdir=terraform output -raw proxy_base_url
OPENAI_API_BASE=http://<ALB_DNS_NAME>/v1

# Bearer token: terraform -chdir=terraform output -raw proxy_api_key
OPENAI_API_KEY=<paste terraform output -raw proxy_api_key>
